# Backend V3 环境变量配置

# ==================== 模型配置 ====================
MODEL_PROVIDER=openai
API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
API_KEY=
MODEL_NAME=qwen3-coder-plus
MODEL_TEMPERATURE=0.3
MODEL_TOP_P=0.9
MODEL_TIMEOUT=120

# ==================== 应用配置 ====================
DEBUG=false
PORT=8000

# ==================== Agent 配置 ====================
MAX_ITERATIONS=3
TEST_TIMEOUT=300
ENABLE_WISDOM=true
MAX_PLAN_RETRIES=2
MAX_FIX_ITERATIONS=3

# ==================== 路径配置 ====================
EXPERIMENTS_DIR=experiments
SKILLS_DIR=skills
WISDOM_DIR=.wisdom