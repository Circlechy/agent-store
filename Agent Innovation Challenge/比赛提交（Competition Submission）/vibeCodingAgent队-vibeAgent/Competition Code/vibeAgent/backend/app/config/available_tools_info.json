{
  "tools": [
    {
      "id": "mock_weather_api",
      "name": "MockWeatherQuery",
      "description": "模拟天气查询接口，返回固定的模拟天气数据，用于测试",
      "category": "天气",
      "method": "GET",
      "path": "http://127.0.0.1:9000/mock_weather",
      "headers": {
        "Content-Type": "application/json"
      },
      "params": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "description": "城市名称，支持中文城市名"
          },
          "date": {
            "type": "string",
            "description": "日期，格式不限"
          }
        },
        "required": ["location"]
      },
      "response": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "城市名称（拼音形式）"
          },
          "country": {
            "type": "string",
            "description": "国家代码（固定为\"CN\"）"
          },
          "weather": {
            "type": "string",
            "description": "天气描述（固定为\"小雨\"）"
          },
          "temperature": {
            "type": "number",
            "description": "当前温度（固定为29.92）"
          },
          "feels_like": {
            "type": "number",
            "description": "体感温度（固定为32.3）"
          },
          "humidity": {
            "type": "number",
            "description": "湿度百分比（固定为58）"
          },
          "wind_speed": {
            "type": "number",
            "description": "风速（固定为4）"
          }
        }
      }
    },
    {
      "id": "movie_api",
      "name": "MovieQuery",
      "description": "根据电影名称查询电影的详细信息，包括导演、演员、类型、评分、简介等",
      "category": "电影",
      "method": "POST",
      "path": "http://127.0.0.1:9001/movie",
      "headers": {
        "Content-Type": "application/json"
      },
      "params": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "电影名称，支持中文或英文名称（如\"肖申克的救赎\"或\"The Shawshank Redemption\"）"
          },
          "name": {
            "type": "string",
            "description": "电影名称的别名，与 title 功能相同"
          },
          "movie": {
            "type": "string",
            "description": "电影名称的别名，与 title 功能相同"
          }
        },
        "required": ["title"]
      },
      "notes": "必须提供 title、name 或 movie 中的至少一个",
      "response": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "电影中文名称"
          },
          "title_en": {
            "type": "string",
            "description": "电影英文名称"
          },
          "year": {
            "type": "number",
            "description": "上映年份"
          },
          "director": {
            "type": "string",
            "description": "导演姓名"
          },
          "actors": {
            "type": "array",
            "description": "主演演员列表",
            "items": {
              "type": "string"
            }
          },
          "genre": {
            "type": "array",
            "description": "电影类型列表（如[\"剧情\", \"犯罪\"]）",
            "items": {
              "type": "string"
            }
          },
          "rating": {
            "type": "number",
            "description": "电影评分（0-10分）"
          },
          "description": {
            "type": "string",
            "description": "电影简介"
          },
          "duration": {
            "type": "number",
            "description": "电影时长（分钟）"
          },
          "country": {
            "type": "string",
            "description": "制片国家"
          }
        }
      }
    },
    {
      "id": "movie_list_api",
      "name": "MovieList",
      "description": "获取电影列表，支持按类型和年份进行筛选",
      "category": "电影",
      "method": "POST",
      "path": "http://127.0.0.1:9001/movie/list",
      "headers": {
        "Content-Type": "application/json"
      },
      "params": {
        "type": "object",
        "properties": {
          "genre": {
            "type": "string",
            "description": "电影类型，如\"科幻\"、\"剧情\"、\"爱情\"等"
          },
          "year": {
            "type": "number",
            "description": "电影年份，如 1994、2010 等"
          }
        },
        "required": []
      },
      "response": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "description": "符合条件的电影数量"
          },
          "movies": {
            "type": "array",
            "description": "电影列表",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "description": "电影中文名称"
                },
                "title_en": {
                  "type": "string",
                  "description": "电影英文名称"
                },
                "year": {
                  "type": "number",
                  "description": "上映年份"
                },
                "genre": {
                  "type": "array",
                  "description": "电影类型列表",
                  "items": {
                    "type": "string"
                  }
                },
                "rating": {
                  "type": "number",
                  "description": "电影评分（0-10分）"
                }
              }
            }
          }
        }
      }
    }
  ]
}
