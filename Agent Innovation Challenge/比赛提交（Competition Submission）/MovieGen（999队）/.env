# Copy this file to ".env" and fill in values.
# PyCharm: open this project and click Run on main.py; it will auto-load .env.

# ===== Text LLM for the 5 planning agents =====
LLM_MODEL_PROVIDER=openai

# DeepSeek OpenAI-compatible base (建议带 /v1)
LLM_API_BASE=https://api.deepseek.com/v1

LLM_API_KEY=sk-66e619e5e3ca4d86919f4f33238feeae
LLM_MODEL_NAME=deepseek-chat

# 关闭自定义证书校验（你之前遇到过 SSL 配置问题）
LLM_SSL_VERIFY=false

# ===== Volcengine Ark / 火山方舟 Seedance 1.5 pro =====
# This repo uses the REST API:
#   POST https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
#   GET  https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks/{id}
ARK_SEEDANCE_CREATE_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
# Use "{task_id}" placeholder (Python format)
ARK_SEEDANCE_QUERY_URL_TEMPLATE=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks/{task_id}

# Model name (example from Ark console)
ARK_SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215

# Your Ark API Key / Bearer token
ARK_API_KEY=1303957b-4590-412e-b61d-d888b190b298

# Optional auth header customization (defaults work for most Bearer-token APIs)
ARK_AUTH_HEADER_NAME=Authorization
ARK_AUTH_HEADER_VALUE_TEMPLATE=Bearer {api_key}

# ===== Generation knobs (defaults are good) =====
SEGMENTS=10
SEGMENT_DURATION_SEC=6
CHAIN_MODE=true
WITH_AUDIO=true
OUTPUT_DIR=./outputs

# Set to true to skip calling Seedance (useful to debug prompts without spending credits)
DRY_RUN=false

# ===== Seedance control flags (optional) =====
# These will be appended to each segment prompt IF the prompt itself doesn't already contain the flag.
ARK_DEFAULT_WATERMARK=true
ARK_DEFAULT_CAMERAFIXED=false
ARK_DEFAULT_FPS=24
ARK_DEFAULT_RATIO=9:16
# ARK_DEFAULT_RESOLUTION=720p

# Provider may not have a dedicated negative prompt field; set to true to inject as text line "避免：..."
ARK_INCLUDE_NEGATIVE_IN_TEXT=false
FFMPEG_BIN=C:\Users\admin\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.0.1-full_build\bin\ffmpeg.exe
RESUME_EDIT=false
REQUIRE_DRAFT_CONFIRM=true
DRAFT_CONFIRM_MODE=terminal