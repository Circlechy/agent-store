# WorkSum Agent配置文件示例
# 使用说明：复制此文件为 .env 文件，填写配置后使用
# 注意：不要将包含真实密钥的 .env 文件提交到版本控制系统

# API密钥：从服务提供商处获取
API_KEY=your_api_key_here
# API服务地址
API_BASE="https://api.example.com/v1"

# 主模型名称
MODEL_NAME="your-model-name"

# 模型服务提供商（openai、anthropic、custom 等）
MODEL_PROVIDER=openai

# SSL证书验证（True/False，生产环境建议 True）
LLM_SSL_VERIFY=False

# 多模态模型名称（处理图像、视频等，如不需要可留空）
MULTIMODAL_MODEL="your-multimodal-model-name"