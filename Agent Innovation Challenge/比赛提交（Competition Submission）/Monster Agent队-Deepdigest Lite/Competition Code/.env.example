# SSL Configuration (禁用 SSL 验证)
LLM_SSL_VERIFY=false
LLM_MODEL_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL_NAME=bytedance-seed/seed-1.6-flash

# Audio Model Configuration (音频转写模型 - Groq Whisper)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_AUDIO_MODEL=whisper-large-v3

# Embedding Model Configuration
EMBEDDING_MODEL=BAAI/bge-m3

# Workflow Timeout Configuration (工作流超时配置，单位：秒)
# 增加超时时间以适应LLM处理大量碎片的场景
WORKFLOW_EXECUTE_TIMEOUT=120
WORKFLOW_STREAM_FRAME_TIMEOUT=120
WORKFLOW_STREAM_FIRST_FRAME_TIMEOUT=120
