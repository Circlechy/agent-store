"""
jiuwen - AI 编程助手

启动脚本 - 使用 Python 3.11 虚拟环境
"""

import sys
import os

# ============================================================================
# 环境变量配置
# ============================================================================

# 1. 清除不兼容的 socks 代理（httpx 不支持）
_proxy_vars = ['http_proxy', 'https_proxy', 'HTTP_PROXY', 'HTTPS_PROXY', 
               'all_proxy', 'ALL_PROXY']
for _var in _proxy_vars:
    _val = os.environ.get(_var, '')
    if _val and 'socks' in _val.lower():
        os.environ.pop(_var, None)

# 2. 禁用 SDK 的 SSL 证书验证（开发环境）
# 如果未设置 LLM_SSL_VERIFY，默认禁用以避免证书配置问题
if 'LLM_SSL_VERIFY' not in os.environ:
    os.environ['LLM_SSL_VERIFY'] = 'false'

# 添加项目根目录到 Python 路径
project_root = os.path.dirname(os.path.abspath(__file__))
if project_root not in sys.path:
    sys.path.insert(0, project_root)

# 添加 agent-core 到路径
agent_core_path = os.path.join(project_root, "agent-core")
if os.path.exists(agent_core_path) and agent_core_path not in sys.path:
    sys.path.insert(0, agent_core_path)

# 启动 CLI
from packages.cli.main import main

if __name__ == "__main__":
    main()
