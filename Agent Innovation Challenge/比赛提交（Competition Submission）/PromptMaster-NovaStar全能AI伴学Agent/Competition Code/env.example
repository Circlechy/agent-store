# NovaStar 环境变量配置文件
# 此文件包含资源类配置，如 API keys、敏感信息等
# 复制此文件为 .env 并填写实际的配置值
# 注意：.env 文件不应提交到代码仓库

# ==================== API Keys ====================

# OpenAI API Key (用于LLM文本调用)
OPENAI_API_KEY=sk-b97a0003d0ac4215bf3351146f52f2df

# OpenAI API Base URL (用于LLM调用的基础URL)
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 模型配置
LLM_MODEL_TYPE=openai
LLM_MODEL_NAME=qwen-plus

# 多模态模型配置
IMAGE_MODEL_NAME=qwen-image-plus
TTS_MODEL_NAME=qwen3-tts-flash
ASR_MODEL_NAME=qwen3-asr-flash

# LLM SSL 配置（openjiuwen框架需要）
LLM_SSL_VERIFY=false
LLM_SSL_CERT=

# 图像生成 API URL
IMAGE_API_BASE=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 语音合成 API URL
TTS_API_BASE=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 语音转文本 API URL
ASR_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions